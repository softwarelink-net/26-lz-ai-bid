    "db:seed": "wrangler d1 execute Allworld --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute Allworld --remote --file=./migrations/0001_init.sql",
    "deploy": "npm run build && wrangler deploy && node scripts/deploy-allworld.mjs 26-lz-ai-bid",
    "deploy:r2": "node scripts/deploy-allworld.mjs 26-lz-ai-bid",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "echarts": "^5.6.0",
